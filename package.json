{
  "name": "ananta-infratech",
  "private": true,
  "version": "1.1.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "overrides": {
    "react-native": "0.74.5",
    "expo-font": "~12.0.10"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:admin-web\"",
    "dev:api": "npm run dev --workspace=services/api",
    "dev:admin-web": "npm run dev --workspace=apps/admin-web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "seed": "npm run seed --workspace=services/api",
    "test": "npm run test --workspace=services/api",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "npm run version:check && npm run lint --workspaces --if-present && npm run test --workspace=services/api && npm run build --workspace=apps/admin-web",
    "version:check": "node scripts/check-version-sync.js"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.3.0",
    "concurrently": "^9.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.4"
  }
}
