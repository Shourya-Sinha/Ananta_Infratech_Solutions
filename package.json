{
  "name": "ananta-infratech",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "overrides": {
    "react-native": "0.74.5"
  },
  "scripts": {
    "dev": "concurrently -n api,web,site -c blue,green,yellow \"npm run dev:api\" \"npm run dev:admin-web\" \"npm run dev:website\"",
    "dev:api": "npm run dev --workspace=services/api",
    "dev:admin-web": "npm run dev --workspace=apps/admin-web",
    "dev:website": "npm run dev --workspace=apps/website",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "seed": "npm run seed --workspace=services/api",
    "test": "npm run test --workspace=services/api",
    "lint": "npm run lint --workspaces --if-present",
    "verify": "npm run lint --workspaces --if-present && npm run test --workspace=services/api && npm run build --workspace=apps/admin-web && npm run build --workspace=apps/website",
    "build:website": "npm run build --workspace=apps/website"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.3.0",
    "concurrently": "^9.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.4"
  }
}
