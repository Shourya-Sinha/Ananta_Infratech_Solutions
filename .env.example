# ─── Ananta Infratech — environment template ─────────────────────────────
# Copy to `.env` at the repo root, then fill in real secrets:
#
#   cp .env.example .env        (macOS / Linux / Git Bash)
#   copy .env.example .env      (Windows CMD / PowerShell)
#
# The API also reads `services/api/.env` when present; values in the
# repo-root `.env` win. Never commit a real `.env` to git.

NODE_ENV=development
PORT=4000

# MongoDB + Redis (defaults match infra/docker/start-dev-services.sh)
MONGODB_URI=mongodb://127.0.0.1:27017/ananta
REDIS_URL=redis://127.0.0.1:6379

# Auth — must each be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_1
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_2
JWT_REFRESH_EXPIRES_IN=30d

# ImageKit (worker document uploads). Free tier at https://imagekit.io
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Comma-separated browser origins allowed to call the API, or * for all.
# Localhost admin dev servers are always allowed regardless of this value.
CORS_ORIGIN=*

# OTP behaviour
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# SMS gateway: "msg91" for real texts, "none" to log OTPs to the console (dev)
SMS_PROVIDER=none
# SMS_API_KEY=
# SMS_SENDER_ID=
# SMS_TEMPLATE_ID=

# Push notifications via Expo's push service (no Firebase project needed)
PUSH_NOTIFICATIONS_ENABLED=true
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: official YouTube Data API key for admin video search.
# Without it, search falls back to parsing the public results page.
# YOUTUBE_API_KEY=

# First super-admin account created by `npm run seed`
SEED_SUPER_ADMIN_PHONE=9999999999
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
